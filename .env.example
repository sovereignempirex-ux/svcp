# Copy to .env and fill in real values. Never commit the real .env file.
# SCVP reads secrets from environment variables only -- never from
# scvp.config.yaml -- so this file documents what a real deployment
# needs without ever containing a real secret.

# SCVP config overrides use the SCVP_ prefix, with __ as the nesting
# separator (maps to model.provider in scvp.config.yaml):
# SCVP_MODEL__PROVIDER=mock
